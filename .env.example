# Public origin of the deployed site, used for canonical URLs, the sitemap,
# robots.txt, Open Graph tags and structured data. No trailing path.
# The build fails fast if this is not an absolute http(s) URL.
NEXT_PUBLIC_SITE_URL=https://klavyn.example.com

# PostHog project API key (the public "phc_..." key, safe to ship to browsers)
# for cookieless page-view and download-click counts sent to eu.i.posthog.com.
# Leave empty to send nothing at all. See src/lib/analytics.ts for what is sent.
NEXT_PUBLIC_POSTHOG_KEY=
